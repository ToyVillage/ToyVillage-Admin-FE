{
  "apiId": "EXCEL_EXPORT",
  "name": "엑셀 내보내기",
  "description": "선택한 항목과 기간의 데이터를 엑셀 또는 압축 파일로 내려받는다",
  "method": "GET",
  "path": "/excel",
  "authentication": {
    "required": true,
    "type": "Bearer",
    "roles": [
      "ADMIN"
    ]
  },
  "contentType": "application/json",
  "headers": [
    {
      "name": "Authorization",
      "location": "header",
      "type": "string",
      "required": true,
      "nullable": false,
      "default": null,
      "example": "Bearer <access-token>",
      "description": "앱 access token",
      "constraints": [
        "Bearer scheme"
      ]
    }
  ],
  "pathParameters": [],
  "queryParameters": [
    {
      "name": "types",
      "location": "query",
      "type": "array<string>",
      "allowedValues": [
        "NOTICE",
        "TASK",
        "WORK_REPORT",
        "RESERVATION",
        "TEAM_MEMBER",
        "ANIMAL",
        "WORK_LOG",
        "FEED_LOG",
        "FIFTH_FLOOR_FEED_LOG",
        "ANIMAL_OBSERVATION",
        "DOCUMENT"
      ],
      "required": true,
      "nullable": false,
      "default": null,
      "example": "TASK",
      "description": "내보낼 항목. 중복은 서버가 제거한다",
      "constraints": [
        "1개 이상",
        "`types=A&types=B` 형식으로 보낸다"
      ]
    },
    {
      "name": "mode",
      "location": "query",
      "type": "enum",
      "allowedValues": [
        "SHEET",
        "ZIP"
      ],
      "required": false,
      "nullable": false,
      "default": "SHEET",
      "example": "SHEET",
      "description": "SHEET = xlsx 한 파일(항목별 시트), ZIP = 항목별 xlsx와 첨부파일 원본",
      "constraints": []
    },
    {
      "name": "startDate",
      "location": "query",
      "type": "string",
      "required": false,
      "nullable": false,
      "default": null,
      "example": "2026-10-01",
      "description": "시작일. 없으면 하한 없음",
      "constraints": [
        "format: date",
        "endDate 이하"
      ]
    },
    {
      "name": "endDate",
      "location": "query",
      "type": "string",
      "required": false,
      "nullable": false,
      "default": null,
      "example": "2026-10-31",
      "description": "종료일. 없으면 상한 없음",
      "constraints": [
        "format: date",
        "startDate 이상"
      ]
    }
  ],
  "requestBody": null,
  "responses": {
    "success": [
      {
        "status": 200,
        "description": "파일 본문",
        "noContent": false,
